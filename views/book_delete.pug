extends layout

block content

  h1 #{title}: #{book.title}

  if book_instances.length
    p #[strong Delete the following copies before attempting to delete this book.]
    div(style='margin-left:20px;margin-top:20px')
      h4 Copies
      dl
        each val in book_instances
          dt
            | ID: 
            a(href=val.url) #{val._id}
          dd #[strong Status:] #{val.status}
          dd #[strong Imprint:] #{val.imprint}
          if val.status != 'Available'
            dd #[strong Due back:] #{val.due_back_formatted}

  else
    p Do you really want to delete this Book?

    form(method='POST')
      div.form-group
        input#bookid.form-control(type='hidden', name='bookid', value=book._id )
      button.btn.btn-primary(type='submit') Delete
